# FALCON-RX environment variables
#
# STATUS: reserved for the future execution engine (Phase 12+). Nothing in this repository
# currently reads these — the dashboard is a client-only demo with no backend, and no
# historical-data ingestion or live/paper trading code has been built yet. This file exists now
# so the shape of the eventual config is documented and reviewable before any real key is ever
# generated, per the project's safety requirements (see docs/SECURITY.md).

# Bitvavo API credentials — scope to "View" + "Trade" ONLY. Never enable "Withdraw" on this key.
BITVAVO_API_KEY=
BITVAVO_API_SECRET=

# Live trading must be explicitly opted into; the system must default to paper trading.
ENABLE_LIVE_TRADING=false

# Reserved for the future data/backtest engine's storage layer (Phase 4+).
DATABASE_URL=
REDIS_URL=
